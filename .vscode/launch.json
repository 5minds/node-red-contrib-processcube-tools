{
    "version": "0.2.0",
    "configurations": [
      {
        "type": "node",
        "request": "attach",
        "name": "Attach to Node-RED",
        "address": "localhost",
        "port": 9229,
        "localRoot": "${workspaceFolder}",
        "remoteRoot": "/package_src",
        "sourceMapPathOverrides": {
          "/usr/src/node-red/node_modules/@5minds/node-red-contrib-processcube-tools/*": "${workspaceFolder}/*",
          "/package_src/*": "${workspaceFolder}/*"
        },
        "resolveSourceMapLocations": [
          "!**/node_modules/**",
          "/usr/src/node-red/node_modules/@5minds/node-red-contrib-processcube-tools/**",
          "/package_src/**"
        ],
        "skipFiles": [
          "<node_internals>/**"
        ]
      }
  ]
}